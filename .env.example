# Node.js / Express backend (never expose JWT or database values to the mobile bundle)
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/classtrack
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:8081
MAX_UPLOAD_MB=10

# Optional HTTPS webhook for one-time password-reset token delivery
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_WEBHOOK_SECRET=
PUBLIC_APP_URL=

# Optional one-time Super Admin seed account; unset these after seeding
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=change-this-to-a-unique-12-character-password

# Browser/device-visible API base URL only; on a phone use a reachable LAN/HTTPS address
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
