{
  "name": "classtrack",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:mobile\"",
    "dev:server": "cross-env PORT=3000 NODE_ENV=development tsx watch backend/src/server.ts",
    "dev:mobile": "cross-env EXPO_PORT=8081 npx expo start --port 8081",
    "start": "expo start --port 8081",
    "start:web": "expo start --web --port 8081",
    "build": "expo export --platform ios --output-dir dist/ios && expo export --platform android --output-dir dist/android",
    "build:server": "esbuild backend/src/server.ts --platform=node --packages=external --bundle --format=cjs --outdir=dist/api",
    "start:server": "NODE_ENV=production node dist/api/server.js",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p backend/tsconfig.json",
    "lint": "expo lint",
    "format": "prettier --write app backend services store types",
    "test": "vitest run",
    "android": "expo start --android --port 8081",
    "ios": "expo start --ios --port 8081",
    "db:seed": "tsx backend/src/scripts/seed.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.12",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.4",
    "multer": "^2.0.2",
    "nativewind": "^4.2.1",
    "pdfkit": "^0.17.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.66.1",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.2.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.3",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.18",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {}
}
